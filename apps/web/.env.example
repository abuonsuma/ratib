# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings -> API). The anon key is designed to be public; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Which business this deployment serves while developing or running a single tenant.
# Leave empty in production multi-tenant mode and set NEXT_PUBLIC_ROOT_DOMAIN instead.
NEXT_PUBLIC_DEFAULT_ORG_SLUG=demo-print

# Multi-tenant mode: acme.ratib.app -> tenant "acme" when the root domain is ratib.app
NEXT_PUBLIC_ROOT_DOMAIN=

# Public URL of this site (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server-only values. Never prefix these with NEXT_PUBLIC_. ----

# Email queue worker (/api/cron/outbox). It bypasses Row Level Security, so keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com): create an API key and verify your sending domain.
RESEND_API_KEY=
EMAIL_FROM="Your Business <orders@yourdomain.com>"

# Any random string of at least 16 characters. Whatever calls the worker must send it as "Authorization: Bearer <value>".
CRON_SECRET=
